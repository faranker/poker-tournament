# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poker_tournament
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=30d

# Server
PORT=3001
CLIENT_URL=https://go-poker.vercel.app

# Email (optional — for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@go-poker.app

# Postgres, as a single connection string — takes priority over DB_* above if set
DATABASE_URL=

# Admin actions (manual approve/reject, /telegram/set-webhook) — required header x-admin-key
ADMIN_KEY=change_this_to_a_long_random_string

# Telegram bot used for payment/donation approval notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SCB auto-approve webhook (line-forwarder-app's scripts/poker_bridge.py) —
# required header x-webhook-secret on POST /payments/scb-deposit
SCB_WEBHOOK_SECRET=change_this_to_a_long_random_string

# Minutes a PaymentModal QR stays active waiting for an auto-matched SCB deposit
PAYMENT_WINDOW_MINUTES=10
